{
  "name": "bobun-ds",
  "version": "0.0.0",
  "private": true,
  "description": "Bobun DS - design system personnel open source avec composants React + tokens DTCG",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:storybook": "turbo run test:storybook",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "turbo boundaries",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "turbo run dev",
    "playground:npm:install": "npm --prefix apps/playground_npm install",
    "playground:npm:build": "npm --prefix apps/playground_npm run build",
    "playground:npm:dev": "npm --prefix apps/playground_npm run dev",
    "storybook": "turbo run storybook --filter=@qhuy/react",
    "storybook:build": "turbo run storybook:build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "playwright"
    ]
  }
}
