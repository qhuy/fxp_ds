---
import '@fxp/react/styles.css'
import '@fxp/tokens/css/fxp.css'
import '@fxp/tokens/css/fxp.dark.css'

const tokenExample = `{
  "color": {
    "brand": {
      "500": {
        "$value": "#14357a",
        "$type": "color"
      }
    }
  },
  "button": {
    "radius": {
      "md": {
        "$value": "12px",
        "$type": "dimension"
      }
    }
  }
}`
---

<html lang="fr" data-theme="light" data-tenant="acme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FanXp Design System — docs</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="section-label">FanXP Design System</p>
          <h1 id="page-title">Une base React + tokens prête pour les marques FanXP.</h1>
          <p class="lead">
            Le design system livre les composants et les contrats. La DA fournit les tokens,
            les devs consomment les packages, les agents IA suivent le quality gate.
          </p>
          <div class="hero-actions" aria-label="Actions principales">
            <a class="fxp-button fxp-button--primary fxp-button--md" href="#da-kit">
              Télécharger le kit DA
            </a>
            <a class="fxp-button fxp-button--outline fxp-button--md" href="#button-preview">
              Voir le Button
            </a>
          </div>
        </div>

        <aside class="artifact" aria-label="Aperçu du contrat tokens">
          <div class="artifact-topline">
            <span>tenant-acme.tokens.json</span>
            <span>DTCG</span>
          </div>
          <pre><code>{tokenExample}</code></pre>
        </aside>
      </section>

      <section class="role-strip" aria-label="Responsabilités">
        <div>
          <strong>DA</strong>
          <span>livre tokens DTCG, modes, états et références Figma.</span>
        </div>
        <div>
          <strong>Dev DS</strong>
          <span>code, teste, documente et valide dans Storybook + playground.</span>
        </div>
        <div>
          <strong>Dev app</strong>
          <span>importe les packages et personnalise uniquement via `--fxp-*`.</span>
        </div>
      </section>

      <section class="kit-section" id="da-kit" aria-labelledby="kit-title">
        <div class="section-heading">
          <p class="section-label">Kit DA</p>
          <h2 id="kit-title">Fichiers à remplir avant intégration</h2>
          <p>
            Ces exemples rendent le contrat concret. La livraison attendue est un export tokens
            utilisable, accompagné d'un brief tenant et d'une checklist de validation.
          </p>
        </div>

        <div class="download-grid">
          <article class="download-card">
            <div class="file-mark">JSON</div>
            <h3>Exemple tokens tenant</h3>
            <p>Structure DTCG minimale avec couleurs, radius et états Button.</p>
            <a
              class="fxp-button fxp-button--secondary fxp-button--sm"
              href="/examples/da/tenant-tokens.example.json"
              download
            >
              Télécharger
            </a>
          </article>

          <article class="download-card">
            <div class="file-mark">MD</div>
            <h3>Brief tenant</h3>
            <p>Contexte marque, modes disponibles, lien Figma, version et changelog.</p>
            <a
              class="fxp-button fxp-button--secondary fxp-button--sm"
              href="/examples/da/brief-tenant.md"
              download
            >
              Télécharger
            </a>
          </article>

          <article class="download-card">
            <div class="file-mark">MD</div>
            <h3>Checklist livraison</h3>
            <p>Contrôles à cocher avant d'envoyer une PR tokens à l'équipe DS.</p>
            <a
              class="fxp-button fxp-button--secondary fxp-button--sm"
              href="/examples/da/checklist-livraison-da.md"
              download
            >
              Télécharger
            </a>
          </article>
        </div>
      </section>

      <section class="preview-section" id="button-preview" aria-labelledby="button-title">
        <div class="section-heading">
          <p class="section-label">Primitive de référence</p>
          <h2 id="button-title">Button multi-tenant</h2>
          <p>
            Rendu avec les classes du package `@fxp/react` et les tokens `@fxp/tokens`.
            Les apps ne changent pas le composant : elles changent les variables.
          </p>
        </div>

        <div class="button-lab">
          <div class="button-stage" aria-label="Aperçu Button">
            <button class="fxp-button fxp-button--primary fxp-button--md" type="button">
              Primary
            </button>
            <button class="fxp-button fxp-button--secondary fxp-button--md" type="button">
              Secondary
            </button>
            <button class="fxp-button fxp-button--outline fxp-button--md" type="button">
              Outline
            </button>
            <button class="fxp-button fxp-button--ghost fxp-button--md" type="button">
              Ghost
            </button>
            <button class="fxp-button fxp-button--destructive fxp-button--md" type="button">
              Destructive
            </button>
            <button class="fxp-button fxp-button--link fxp-button--md" type="button">
              Link
            </button>
            <button class="fxp-button fxp-button--primary fxp-button--sm" type="button">
              Small
            </button>
            <button class="fxp-button fxp-button--primary fxp-button--lg" type="button">
              Large
            </button>
            <button
              class="fxp-button fxp-button--primary fxp-button--icon"
              type="button"
              aria-label="Ajouter"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </button>
            <button class="fxp-button fxp-button--primary fxp-button--md" type="button" disabled>
              Disabled
            </button>
          </div>

          <div class="token-stack" aria-label="Variables utilisées">
            <span>--fxp-color-brand-500</span>
            <span>--fxp-button-radius-md</span>
            <span>--fxp-button-height-md</span>
            <span>--fxp-color-focus-ring</span>
          </div>
        </div>
      </section>

      <section class="workflow-section" id="workflow" aria-labelledby="workflow-title">
        <div>
          <p class="section-label">Workflow</p>
          <h2 id="workflow-title">Ce qu'il faut lancer</h2>
        </div>
        <div class="command-list">
          <pre><code>pnpm --filter @fxp/docs dev</code></pre>
          <pre><code>pnpm storybook</code></pre>
          <pre><code>pnpm lint && pnpm typecheck</code></pre>
        </div>
      </section>
    </main>

    <style>
      :global(html) {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 8% 6%, rgb(20 53 122 / 14%), transparent 28rem),
          linear-gradient(135deg, #f7f3eb 0%, #f8fafc 44%, #eef6f1 100%);
        color: #132018;
        font-family: var(--fxp-font-family-sans);
      }

      .page-shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 28px 0 72px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
        gap: 32px;
        align-items: center;
        min-height: 620px;
      }

      .hero-copy {
        padding: 32px 0;
      }

      .section-label {
        margin: 0 0 14px;
        color: #007a5a;
        font-size: var(--fxp-font-size-sm);
        font-weight: var(--fxp-font-weight-medium);
        letter-spacing: 0;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 760px;
        margin-bottom: 24px;
        font-size: clamp(3rem, 7.2vw, 6.4rem);
        line-height: 0.92;
        letter-spacing: 0;
      }

      h2 {
        margin-bottom: 12px;
        font-size: clamp(2rem, 4vw, 3.4rem);
        line-height: 1;
        letter-spacing: 0;
      }

      h3 {
        margin-bottom: 8px;
        font-size: 1.05rem;
        line-height: var(--fxp-line-height-tight);
      }

      .lead {
        max-width: 640px;
        margin-bottom: 30px;
        color: #3d4d43;
        font-size: 1.12rem;
        line-height: 1.65;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .artifact {
        overflow: hidden;
        border: 1px solid rgb(19 32 24 / 12%);
        border-radius: 8px;
        background: #101914;
        box-shadow: 0 28px 70px rgb(19 32 24 / 18%);
      }

      .artifact-topline {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 18px;
        border-bottom: 1px solid rgb(255 255 255 / 10%);
        color: #cbd8ce;
        font-size: 0.8rem;
      }

      .artifact pre,
      .command-list pre {
        overflow-x: auto;
        margin: 0;
      }

      .artifact pre {
        padding: 22px;
        color: #d7f4e2;
        font-size: 0.9rem;
        line-height: 1.62;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.92em;
      }

      .role-strip,
      .kit-section,
      .preview-section,
      .workflow-section {
        border: 1px solid rgb(19 32 24 / 10%);
        border-radius: 8px;
        background: rgb(255 255 255 / 76%);
        box-shadow: 0 18px 55px rgb(19 32 24 / 8%);
      }

      .role-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        overflow: hidden;
        margin-bottom: 22px;
        background: rgb(19 32 24 / 10%);
      }

      .role-strip div {
        display: grid;
        gap: 8px;
        min-height: 112px;
        padding: 22px;
        background: rgb(255 255 255 / 88%);
      }

      .role-strip strong {
        font-size: 1rem;
      }

      .role-strip span,
      .section-heading p,
      .download-card p,
      .workflow-section p {
        color: #4b5c51;
        line-height: var(--fxp-line-height-normal);
      }

      .kit-section,
      .preview-section,
      .workflow-section {
        margin-top: 22px;
        padding: 28px;
      }

      .section-heading {
        max-width: 760px;
        margin-bottom: 24px;
      }

      .download-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .download-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 230px;
        padding: 20px;
        border: 1px solid rgb(19 32 24 / 10%);
        border-radius: 8px;
        background: #fffaf1;
      }

      .download-card p {
        margin-bottom: 20px;
      }

      .download-card a {
        margin-top: auto;
      }

      .file-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        height: 28px;
        margin-bottom: 18px;
        border-radius: 6px;
        background: #14357a;
        color: white;
        font-size: 0.72rem;
        font-weight: var(--fxp-font-weight-medium);
      }

      .button-lab {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 18px;
        align-items: stretch;
      }

      .button-stage {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-content: center;
        align-items: center;
        min-height: 220px;
        padding: 22px;
        border: 1px dashed rgb(20 53 122 / 22%);
        border-radius: 8px;
        background:
          linear-gradient(90deg, rgb(20 53 122 / 5%) 1px, transparent 1px),
          linear-gradient(180deg, rgb(20 53 122 / 5%) 1px, transparent 1px),
          #f7faf8;
        background-size: 28px 28px;
      }

      .button-stage svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
      }

      .token-stack {
        display: grid;
        gap: 8px;
        align-content: center;
        padding: 18px;
        border-radius: 8px;
        background: #132018;
      }

      .token-stack span {
        display: block;
        padding: 9px 10px;
        border: 1px solid rgb(255 255 255 / 12%);
        border-radius: 6px;
        color: #d7f4e2;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .workflow-section {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 24px;
      }

      .command-list {
        display: grid;
        gap: 10px;
      }

      .command-list pre {
        padding: 14px 16px;
        border-radius: 8px;
        background: #101914;
        color: #d7f4e2;
      }

      @media (max-width: 920px) {
        .hero,
        .button-lab,
        .workflow-section {
          grid-template-columns: 1fr;
        }

        .hero {
          min-height: auto;
          padding-top: 28px;
        }

        .download-grid,
        .role-strip {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        .page-shell {
          width: min(100% - 24px, 1180px);
          padding-top: 16px;
        }

        h1 {
          font-size: 3rem;
        }

        .kit-section,
        .preview-section,
        .workflow-section {
          padding: 20px;
        }
      }
    </style>
  </body>
</html>
