{
  "name": "@qhuy/tokens",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Tokens DTCG Bobun DS — couleurs, typo, spacing, radius, shadows. Pipeline Style Dictionary 4.",
  "type": "module",
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./css/fxp.css": "./dist/css/fxp.css",
    "./css/fxp.dark.css": "./dist/css/fxp.dark.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "style-dictionary build --config ./style-dictionary.config.mjs && cp src/css/fxp.dark.css dist/css/fxp.dark.css",
    "typecheck": "echo \"@qhuy/tokens: pas de TS source — .d.ts générés par Style Dictionary\"",
    "test": "echo \"no tests yet\"",
    "lint": "echo \"no lint yet\""
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "typescript": "catalog:"
  }
}
